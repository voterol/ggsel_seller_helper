# GGSel API
GGSEL_SELLER_ID=1234567
GGSEL_API_KEY=your_api_key_here

# Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_GROUP_ID=-1001234567890
# Comma-separated numeric Telegram user IDs permitted to use commands,
# callbacks, and operator message actions. Empty means nobody is authorized.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Optional
POLL_INTERVAL=15
CHAT_CHECK_INTERVAL=40

# Secure updater (disabled unless explicitly enabled)
# UPDATE_VERSION must exactly match the immutable GitHub release tag.
AUTO_UPDATE=false
UPDATE_VERSION=
UPDATE_SHA256=
